; debian server fail2ban ssh config.

[sshd]
enabled  = true
port     = ssh
filter   = sshd
logpath  = %(syslog_authpriv)s
maxretry = {{ fail2ban.ssh.max_retries }}
bantime = {{ fail2ban.ssh.bantime }}